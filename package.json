{
  "name": "bugproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns bug tickets into executable Playwright regression tests through a closed-loop red/green verification cycle.",
  "bin": {
    "bugproof": "./bin/bugproof.js"
  },
  "scripts": {
    "app": "tsx app/server.ts",
    "bugproof": "tsx src/cli.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "commander": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
